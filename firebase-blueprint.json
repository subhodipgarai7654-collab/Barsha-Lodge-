{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator account with full lodge management permissions",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address"
        },
        "name": {
          "type": "string",
          "description": "Admin full name",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "manager", "staff"],
          "description": "Role of the administrator"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when admin profile was created"
        }
      },
      "required": ["email", "name", "role"]
    },
    "Room": {
      "title": "Room",
      "description": "Hotel accommodation room details and availability status",
      "type": "object",
      "properties": {
        "room_number": {
          "type": "string",
          "description": "Unique room number identifier",
          "maxLength": 20
        },
        "name": {
          "type": "string",
          "description": "Room display name",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Room type category",
          "enum": ["single", "single_ac", "double", "double_ac", "triple", "triple_ac", "suite", "four_bed", "dormitory"]
        },
        "is_ac": {
          "type": "integer",
          "description": "1 for AC room, 0 for Non-AC"
        },
        "bed_type": {
          "type": "string",
          "description": "Bed configuration"
        },
        "price_per_night": {
          "type": "number",
          "description": "Nightly tariff rate in INR"
        },
        "capacity": {
          "type": "integer",
          "description": "Maximum guest occupancy"
        },
        "amenities": {
          "type": "string",
          "description": "JSON array or list of room amenities"
        },
        "status": {
          "type": "string",
          "enum": ["Available", "Booked", "Occupied", "Maintenance"],
          "description": "Current room availability status"
        },
        "image_url": {
          "type": "string",
          "description": "Public photo URL of the room"
        },
        "description": {
          "type": "string",
          "description": "Room description",
          "maxLength": 1000
        }
      },
      "required": ["room_number", "name", "price_per_night", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Guest reservation record for lodge accommodations",
      "type": "object",
      "properties": {
        "booking_id": {
          "type": "string",
          "description": "Human readable reservation reference e.g. BL2026-0001",
          "maxLength": 30
        },
        "room_id": {
          "type": "integer",
          "description": "Associated room identifier"
        },
        "guest_name": {
          "type": "string",
          "description": "Full name of the primary pilgrim/guest",
          "maxLength": 100
        },
        "mobile_number": {
          "type": "string",
          "description": "Contact phone or WhatsApp mobile number",
          "maxLength": 20
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address"
        },
        "check_in_date": {
          "type": "string",
          "description": "Arrival date (YYYY-MM-DD)",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "check_out_date": {
          "type": "string",
          "description": "Departure date (YYYY-MM-DD)",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "num_guests": {
          "type": "integer",
          "description": "Number of staying guests"
        },
        "num_rooms": {
          "type": "integer",
          "description": "Number of rooms booked"
        },
        "special_requests": {
          "type": "string",
          "description": "Pilgrim puja arrangements, ground floor request, etc.",
          "maxLength": 500
        },
        "price_per_night": {
          "type": "number",
          "description": "Tariff per night"
        },
        "total_nights": {
          "type": "integer",
          "description": "Stay duration in nights"
        },
        "total_amount": {
          "type": "number",
          "description": "Total booking amount in INR"
        },
        "advance_amount": {
          "type": "number",
          "description": "Advance token deposit paid via UPI"
        },
        "due_amount": {
          "type": "number",
          "description": "Balance payable at check-in"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Checked-in", "Checked-out", "Cancelled"],
          "description": "Booking workflow state"
        },
        "payment_status": {
          "type": "string",
          "enum": ["Pending", "Partially Paid", "Paid", "Refunded", "Pending Verification"],
          "description": "UPI payment verification status"
        },
        "payment_method": {
          "type": "string",
          "description": "Payment channel e.g. UPI, Cash"
        },
        "transaction_id": {
          "type": "string",
          "description": "UPI reference/UTR transaction ID",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation"
        }
      },
      "required": ["booking_id", "guest_name", "mobile_number", "check_in_date", "check_out_date", "total_amount", "status"]
    },
    "WebsiteSetting": {
      "title": "WebsiteSetting",
      "description": "Key-value pair for website configurations, UPI and contacts",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Configuration key",
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "description": "Configuration value"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when setting was updated"
        }
      },
      "required": ["key", "value"]
    },
    "User": {
      "title": "User",
      "description": "Registered guest profile and account credentials",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID or unique ID" },
        "email": { "type": "string", "format": "email", "description": "Guest email" },
        "name": { "type": "string", "description": "Guest full name" },
        "phone": { "type": "string", "description": "Guest phone number" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Account role" },
        "createdAt": { "type": "string", "description": "Registration timestamp" }
      },
      "required": ["email", "name", "role"]
    },
    "AIKnowledgeBase": {
      "title": "AIKnowledgeBase",
      "description": "Official knowledge articles, travel guides, and FAQ entries used by Barsha AI",
      "type": "object",
      "properties": {
        "category": { "type": "string", "description": "Knowledge category (lodge_info, rooms, policies, tarapith_guide, faqs, contact)" },
        "topic": { "type": "string", "description": "Topic heading" },
        "content": { "type": "string", "description": "Detailed text content" },
        "sort_order": { "type": "integer", "description": "Sorting priority" }
      },
      "required": ["category", "topic", "content"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Registered administrator accounts and privileged managers"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Rooms catalog with live availability and tariff"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "All customer reservations and room bookings"
    },
    "/website_settings/{settingKey}": {
      "schema": "WebsiteSetting",
      "description": "Global website configuration, contacts, UPI and custom domain"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered guest user profiles"
    },
    "/ai_knowledge_base/{docId}": {
      "schema": "AIKnowledgeBase",
      "description": "Lodge knowledge articles and FAQs"
    }
  }
}
